<!DOCTYPE html> <html lang="ko"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>내 일정관리</title> <style> * { box-sizing: border-box; margin: 0; padding: 0; } body { font-family: -apple-system, "Malgun Gothic", "Apple SD Gothic Neo", sans-serif; background: #f2f4f8; color: #222; min-height: 100vh; } .app { max-width: 560px; margin: 0 auto; padding: 24px 16px 48px; } .app-header h1 { font-size: 1.6rem; color: #4a90e2; } .today { margin-top: 4px; color: #777; font-size: 0.95rem; } .card { background: #fff; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); } .form { margin-top: 20px; padding: 16px; display: flex; flex-direction: column; gap: 10px; } .row { display: flex; gap: 10px; } .row input { flex: 1; min-width: 0; } input { font-size: 1rem; padding: 12px; border: 1px solid #dde1e7; border-radius: 10px; outline: none; font-family: inherit; } input:focus { border-color: #4a90e2; } .btn-add { font-size: 1rem; font-weight: bold; padding: 12px; border: none; border-radius: 10px; background: #4a90e2; color: #fff; cursor: pointer; } .btn-add:active { background: #3a78c2; } .filters { display: flex; gap: 8px; margin-top: 20px; } .filter { flex: 1; padding: 10px; font-size: 0.95rem; border: 1px solid #dde1e7; border-radius: 20px; background: #fff; color: #555; cursor: pointer; } .filter.active { background: #4a90e2; border-color: #4a90e2; color: #fff; } .summary { margin: 14px 4px 6px; font-size: 0.9rem; color: #777; } .day-group { margin-top: 14px; } .day-title { font-size: 0.95rem; color: #555; margin: 0 4px 8px; } .day-title.is-today { color: #4a90e2; } .day-title.is-past { color: #d9534f; } .item { display: flex; align-items: center; gap: 12px; padding: 14px; margin-bottom: 8px; } .item input[type="checkbox"] { width: 22px; height: 22px; flex-shrink: 0; accent-color: #4a90e2; cursor: pointer; } .item-body { flex: 1; min-width: 0; } .item-time { font-size: 0.8rem; color: #4a90e2; font-weight: bold; } .item-text { font-size: 1rem; word-break: break-all; } .item.done .item-text { text-decoration: line-through; color: #aaa; } .item.done .item-time { color: #aaa; } .btn-delete { border: none; background: none; color: #bbb; font-size: 1.3rem; cursor: pointer; padding: 4px 8px; } .btn-delete:hover { color: #d9534f; } .empty { text-align: center; color: #999; padding: 40px 0; } </style> </head> <body> <main class="app"> <header class="app-header"> <h1>내 일정관리</h1> <p id="today-label" class="today"></p> </header> <!-- 일정 입력 폼 --> <form id="schedule-form" class="card form"> <input type="text" id="text-input" placeholder="할 일을 입력하세요" maxlength="100" required> <div class="row"> <input type="date" id="date-input" required> <input type="time" id="time-input"> </div> <button type="submit" class="btn-add">일정 추가</button> </form> <!-- 보기 필터 --> <nav class="filters"> <button class="filter active" data-filter="all">전체</button> <button class="filter" data-filter="todo">남은 일</button> <button class="filter" data-filter="done">완료</button> </nav> <p id="summary" class="summary"></p> <!-- 일정 목록 --> <section id="list"></section> </main> <script> // ===== 요소 가져오기 ===== const form = document.getElementById('schedule-form'); const textInput = document.getElementById('text-input'); const dateInput = document.getElementById('date-input'); const timeInput = document.getElementById('time-input'); const list = document.getElementById('list'); const summary = document.getElementById('summary'); const filterButtons = document.querySelectorAll('.filter'); const STORAGE_KEY = 'my-schedules'; let schedules = load(); let currentFilter = 'all'; // ===== 날짜 도우미 ===== function todayString() { const d = new Date(); const m = String(d.getMonth() + 1).padStart(2, '0'); const day = String(d.getDate()).padStart(2, '0'); return `${d.getFullYear()}-${m}-${day}`; } function formatDate(dateStr) { const [y, m, d] = dateStr.split('-').map(Number); const week = ['일', '월', '화', '수', '목', '금', '토']; const dayName = week[new Date(y, m - 1, d).getDay()]; return `${m}월 ${d}일 (${dayName})`; } function dayDiff(dateStr) { const [y, m, d] = dateStr.split('-').map(Number); const target = new Date(y, m - 1, d); const now = new Date(); const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()); return Math.round((target - today) / 86400000); } // ===== 저장 / 불러오기 ===== function save() { localStorage.setItem(STORAGE_KEY, JSON.stringify(schedules)); } function load() { try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch { return []; } } // ===== 일정 추가 ===== form.addEventListener('submit', (e) => { e.preventDefault(); const text = textInput.value.trim(); if (!text) return; schedules.push({ id: Date.now(), text: text, date: dateInput.value, time: timeInput.value, // 비워두면 "종일" done: false, }); save(); render(); textInput.value = ''; timeInput.value = ''; textInput.focus(); }); // ===== 필터 버튼 ===== filterButtons.forEach((btn) => { btn.addEventListener('click', () => { filterButtons.forEach((b) => b.classList.remove('active')); btn.classList.add('active'); currentFilter = btn.dataset.filter; render(); }); }); // ===== 완료 체크 / 삭제 ===== function toggleDone(id) { const item = schedules.find((s) => s.id === id); item.done = !item.done; save(); render(); } function removeItem(id) { if (!confirm('이 일정을 삭제할까요?')) return; schedules = schedules.filter((s) => s.id !== id); save(); render(); } // ===== 화면 그리기 ===== function render() { list.innerHTML = ''; let visible = schedules; if (currentFilter === 'todo') visible = schedules.filter((s) => !s.done); if (currentFilter === 'done') visible = schedules.filter((s) => s.done); visible = [...visible].sort((a, b) => (a.date + (a.time || '00:00')).localeCompare(b.date + (b.time || '00:00')) ); const left = schedules.filter((s) => !s.done).length; summary.textContent = `전체 ${schedules.length}개 · 남은 일 ${left}개`; if (visible.length === 0) { const empty = document.createElement('p'); empty.className = 'empty'; empty.textContent = '일정이 없어요. 위에서 추가해 보세요!'; list.appendChild(empty); return; } let lastDate = null; let group = null; visible.forEach((s) => { if (s.date !== lastDate) { lastDate = s.date; group = document.createElement('div'); group.className = 'day-group'; const title = document.createElement('h2'); title.className = 'day-title'; const diff = dayDiff(s.date); let label = formatDate(s.date); if (diff === 0) { label += ' · 오늘'; title.classList.add('is-today'); } else if (diff === 1) label += ' · 내일'; else if (diff < 0) { label += ' · 지남'; title.classList.add('is-past'); } title.textContent = label; group.appendChild(title); list.appendChild(group); } const row = document.createElement('div'); row.className = 'card item' + (s.done ? ' done' : ''); const check = document.createElement('input'); check.type = 'checkbox'; check.checked = s.done; check.addEventListener('change', () => toggleDone(s.id)); const body = document.createElement('div'); body.className = 'item-body'; const time = document.createElement('div'); time.className = 'item-time'; time.textContent = s.time || '종일'; const text = document.createElement('div'); text.className = 'item-text'; text.textContent = s.text; body.append(time, text); const del = document.createElement('button'); del.className = 'btn-delete'; del.textContent = '×'; del.title = '삭제'; del.addEventListener('click', () => removeItem(s.id)); row.append(check, body, del); group.appendChild(row); }); } // ===== 시작 ===== document.getElementById('today-label').textContent = '오늘은 ' + formatDate(todayString()); dateInput.value = todayString(); render(); </script> </body> </html>
